#!/bin/sh
# Identity leak guard, as a git pre-push hook. Install and background: docs/dev/identity-guard.md.
#
# For every ref being pushed it scans the tree of the commit being pushed, and checks the
# committer, message, added lines and author of each commit the remote does not already have, so
# a leak one commit adds and the next removes is stopped too. It never prints a denylist entry or
# the text that matched one, only where and which entry number.
#
# The denylist is read from $LIKEARR_IDENTITY_DENYLIST_FILE, or else
# ~/.config/likearr/identity-denylist.txt. A missing file stops the push.
set -eu

remote_name="${1:-}"
remote_url="${2:-}"
denylist="${LIKEARR_IDENTITY_DENYLIST_FILE:-$HOME/.config/likearr/identity-denylist.txt}"

if [ ! -f "$denylist" ]; then
    echo "identity guard: no denylist at \$LIKEARR_IDENTITY_DENYLIST_FILE or ~/.config/likearr/identity-denylist.txt; push stopped." >&2
    echo "identity guard: see docs/dev/identity-guard.md." >&2
    exit 1
fi

top="$(git rev-parse --show-toplevel)"
guard="$top/scripts/identity_guard.py"
if [ ! -f "$guard" ]; then
    echo "identity guard: $guard is missing; push stopped." >&2
    exit 1
fi

status=0
scanned=" "

# git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
# Every command in the loop reads /dev/null, never the loop's stdin, so none can eat later refs.
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;; # a deletion sends nothing
    esac

    # Several refs at one object (a branch and its tag, --tags, --mirror) share one tree scan.
    case "$scanned" in
        *" $local_sha "*) ;;
        *)
            python3 "$guard" --denylist-file "$denylist" --rev "$local_sha" </dev/null || status=1
            scanned="$scanned$local_sha "
            ;;
    esac

    case "$remote_sha" in
        *[!0]*) has_remote=1 ;;
        *) has_remote=0 ;;
    esac
    if [ "$has_remote" = 1 ] && git cat-file -e "${remote_sha}^{commit}" </dev/null 2>/dev/null; then
        python3 "$guard" --denylist-file "$denylist" --commits "${remote_sha}..${local_sha}" </dev/null || status=1
    elif [ -n "$remote_name" ] && [ "$remote_name" != "$remote_url" ]; then
        # A new branch, or a remote tip this clone has never fetched: everything not already on
        # this remote's tracking branches.
        python3 "$guard" --denylist-file "$denylist" --commits "$local_sha" --exclude-remote "$remote_name" \
            </dev/null || status=1
    else
        # A push straight to a URL has no tracking branches to leave out: check all of it.
        python3 "$guard" --denylist-file "$denylist" --commits "$local_sha" </dev/null || status=1
    fi
done

if [ "$status" -ne 0 ]; then
    echo "identity guard: push stopped." >&2
fi
exit "$status"
