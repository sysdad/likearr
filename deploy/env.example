# likearr secrets - example.
#
# Copy to .env next to compose.yaml (or wherever your process manager reads env vars from) and fill
# in real values. Never commit the filled-in file. These are the ONLY secrets likearr reads;
# config.toml never contains credentials.

# Lidarr API key (Settings -> General -> Security). Required.
LIKEARR_LIDARR_API_KEY=<your lidarr api key>

# Spotify app client id (developer.spotify.com/dashboard). Required for Spotify sources.
LIKEARR_SPOTIFY_CLIENT_ID=<your spotify client id>

# Spotify app client secret. Optional: the PKCE auth flow likearr uses does not need one.
# LIKEARR_SPOTIFY_CLIENT_SECRET=<your spotify client secret>

# Only needed if [health.mqtt] is configured in config.toml and your broker requires auth.
# LIKEARR_MQTT_USERNAME=<mqtt username>
# LIKEARR_MQTT_PASSWORD=<mqtt password>

# Optional, not a secret: container timezone. Log timestamps are forced to UTC regardless
# (likearr/logging_setup.py), so this changes only the CLI's one local-time message, nothing
# more. When scheduled runs fire is [schedule] timezone in config.toml, set from Settings, not
# this.
# TZ=America/New_York

# Web UI password. Required: set a long random one here, at least 16 characters -
# `openssl rand -base64 24` makes one. The service (`likearr start`) refuses to start while it is
# empty or shorter than 16. Keep it in your password manager; every host on the LAN can reach the
# UI's port directly.
LIKEARR_UI_PASSWORD=
