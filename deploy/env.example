# likearr environment - example.
#
# Copy to .env next to compose.yaml, fill it in, and `chmod 600 .env`. Never commit it.
# Running from source? likearr doesn't read .env itself: load it with `set -a; . ./.env; set +a`.

# Required. Lidarr's address as this container reaches it. `http://lidarr:8686` works only when
# both containers share a Docker network; otherwise use Lidarr's LAN address.
LIKEARR_LIDARR_URL=http://lidarr:8686

# Optional. Host names you browse to likearr by, comma-separated, no port. Unset, it answers to any
# IPv4 address (http://192.168.1.20:8770) but to no host name.
# LIKEARR_ALLOWED_HOSTS=likearr.example.org

# Optional. An email or URL MusicBrainz can reach you at. Unset, likearr's project URL.
# LIKEARR_MUSICBRAINZ_CONTACT=you@example.org

# Required. Lidarr -> Settings -> General -> Security -> API Key.
LIKEARR_LIDARR_API_KEY=<your lidarr api key>

# Required. Your Spotify app's Client ID - see docs/spotify.md.
LIKEARR_SPOTIFY_CLIENT_ID=<your spotify client id>

# Not needed: likearr signs in to Spotify without a client secret.
# LIKEARR_SPOTIFY_CLIENT_SECRET=<your spotify client secret>

# Only if [health.mqtt] is set in config.toml and your broker needs a login.
# LIKEARR_MQTT_USERNAME=<mqtt username>
# LIKEARR_MQTT_PASSWORD=<mqtt password>

# Optional. The container's timezone; logs stay in UTC either way. When scheduled runs fire is
# set in Settings ([schedule] timezone), not here.
# TZ=America/New_York

# Required. The web UI password, 16 characters or more: `openssl rand -base64 24` makes one.
LIKEARR_UI_PASSWORD=
